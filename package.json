{
  "name": "template-bun",
  "description": "A Phaser 3 template using bun.",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-bun.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-bun/issues"
  },
  "homepage": "https://github.com/phaserjs/template-bun#readme",
  "scripts": {
    "gen:frames": "bun tools/gen_frame_multiatlas.mjs",
    "gen:frames:check": "bun tools/gen_frame_multiatlas.mjs --check",
    "predev": "bun run gen:frames",
    "prebuild": "bun run gen:frames",
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "bun log.js dev && bun x --bun vite --config vite/config.dev.mjs",
    "dev:server": "bun --watch server/src/index.ts",
    "build": "bun log.js build && bun x --bun vite build --config vite/config.prod.mjs",
    "dev-nolog": "bun x --bun vite --config vite/config.dev.mjs",
    "build-nolog": "bun x --bun vite build --config vite/config.prod.mjs",
    "start": "NODE_ENV=production bun server/src/index.ts",
    "test:server": "bun test server/src/app.test.ts",
    "lint": "biome lint .",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "phaser": "4.0.0"
  }
}
